{
    "name": "ozzy0s/taskflow-api",
    "description": "API REST para gerenciamento de projetos e tarefas, construída com PHP puro, PDO, MySQL e JWT.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-pdo": "*",
        "firebase/php-jwt": "^7.2",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "TaskFlow\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TaskFlow\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "migrate": "php bin/migrate.php",
        "serve": "php -S 127.0.0.1:8000 -t public public/router.php",
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
