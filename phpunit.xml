<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         failOnWarning="true"
         failOnRisky="true">
    <testsuites>
        <testsuite name="TaskFlow API">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_DEBUG" value="true" force="true"/>
        <env name="DB_HOST" value="127.0.0.1" force="true"/>
        <env name="DB_PORT" value="3306" force="true"/>
        <env name="DB_DATABASE" value="taskflow_test" force="true"/>
        <env name="DB_USERNAME" value="taskflow" force="true"/>
        <env name="DB_PASSWORD" value="taskflow" force="true"/>
        <env name="JWT_SECRET" value="testing-secret-key-with-at-least-32-chars" force="true"/>
        <env name="JWT_TTL" value="3600" force="true"/>
        <env name="PASSWORD_HASH_COST" value="4" force="true"/>
    </php>
</phpunit>
